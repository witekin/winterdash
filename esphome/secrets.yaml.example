# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is git-ignored and must never be committed.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# NOTE: the fallback setup AP ("WinterDashAP") is now OPEN (no password) so a
# non-technical user can join it to onboard Wi-Fi — ap_password is no longer used.

# OTA update password (used for over-the-air firmware updates)
ota_password: "change-me-ota"

